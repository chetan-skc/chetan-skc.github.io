# Generated with GitHub Copilot - [Tracking ID: Hexure-Copilot]
# Copy this file to .env.local and fill in the values you need.
# Everything is optional. Without keys the site runs in demo mode:
#   - Forge Wall (spark counter + guestbook) is stored in each visitor's browser
#   - The contact form opens the visitor's email app with the message pre-filled
# These values end up in the public JS bundle by design. Web3Forms keys only deliver
# mail to your inbox, and Firebase access is enforced by firestore.rules.

# Contact form: free access key from https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# Forge Wall: Firebase console > Project settings > Your apps > Web app (SDK config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
