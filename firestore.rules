// Generated with GitHub Copilot - [Tracking ID: Hexure-Copilot]
rules_version = '2';

// Keep these limits in sync with LIMITS in src/lib/liveStore.js.
service cloud.firestore {
  match /databases/{database}/documents {

    // Global spark counter: public read; each write may add between 1 and 25 sparks.
    match /stats/sparks {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 1
        && request.resource.data.count <= 25;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count > resource.data.count
        && request.resource.data.count <= resource.data.count + 25;
      allow delete: if false;
    }

    // Guestbook: public read, validated create-only writes. Moderate entries from the Firebase console.
    match /guestbook/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'metal', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 180
        && request.resource.data.metal in ['copper', 'gold', 'silver', 'steel', 'titanium']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
